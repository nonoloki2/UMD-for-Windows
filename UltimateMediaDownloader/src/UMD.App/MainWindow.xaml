<Window x:Class="UMD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UMD.App.ViewModels"
        Title="Ultimate Media Downloader"
        Icon="app.ico"
        Height="680" Width="940"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- aviso de ferramentas -->
            <RowDefinition Height="Auto" />
            <!-- painel de entrada -->
            <RowDefinition Height="Auto" />
            <!-- cabecalho da fila -->
            <RowDefinition Height="*" />
            <!-- fila -->
            <RowDefinition Height="Auto" />
            <!-- rodape -->
        </Grid.RowDefinitions>

        <!-- Aviso quando falta algum binario externo -->
        <Border Grid.Row="0"
                Background="#3A2A1B" BorderBrush="#7A5A2A" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,14"
                Visibility="{Binding ToolsOk, Converter={StaticResource BoolToVis}, ConverterParameter=inverter}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="!" FontWeight="Bold" FontSize="15" Foreground="#E8B04B"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToolStatus}" TextWrapping="Wrap"
                           Foreground="#E8D5B0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Painel de entrada -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>

                <TextBlock Text="Endereco da midia" Style="{StaticResource LabelText}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             TabIndex="0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="Adicionar a fila"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"
                            Margin="10,0,0,0" TabIndex="1" />
                </Grid>

                <TextBlock Text="{Binding DetectedPlatform, StringFormat='Plataforma: {0}'}"
                           Foreground="{StaticResource AccentBrush}" FontSize="12"
                           Margin="2,0,0,14"
                           Visibility="{Binding DetectedPlatform, Converter={StaticResource EmptyToVis}}" />

                <!-- Modo e qualidade -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom"
                                Margin="0,0,20,0">
                        <RadioButton Content="Video"
                                     IsChecked="{Binding IsVideoMode, Mode=OneWay}"
                                     Checked="VideoMode_Checked" />
                        <RadioButton Content="Somente audio"
                                     IsChecked="{Binding AudioOnly, Mode=OneWay}"
                                     Checked="AudioMode_Checked" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <!-- Qualidade de video -->
                        <StackPanel HorizontalAlignment="Left" MinWidth="240" MaxWidth="320"
                                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Qualidade" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding Qualities}"
                                      SelectedItem="{Binding SelectedQuality}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Formato de audio -->
                        <StackPanel HorizontalAlignment="Left" MinWidth="240" MaxWidth="320"
                                    Visibility="{Binding AudioOnly, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Formato do audio" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding AudioFormats}"
                                      SelectedItem="{Binding SelectedAudioFormat}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Pasta de saida -->
                <TextBlock Text="Salvar em" Style="{StaticResource LabelText}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" />
                    <Button  Grid.Column="1" Content="Procurar..." Command="{Binding BrowseCommand}"
                             Margin="8,0,0,0" />
                    <Button  Grid.Column="2" Content="Abrir" Command="{Binding OpenOutputCommand}"
                             Margin="8,0,0,0" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- Cabecalho da fila -->
        <Grid Grid.Row="2" Margin="2,0,2,10">
            <TextBlock Text="Fila de downloads" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar tudo" Style="{StaticResource SmallButton}"
                        Command="{Binding CancelAllCommand}" Margin="0,0,8,0" />
                <Button Content="Limpar concluidos" Style="{StaticResource SmallButton}"
                        Command="{Binding ClearFinishedCommand}" />
            </StackPanel>
        </Grid>

        <!-- Fila -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <TextBlock Text="Nenhum download ainda. Cole um endereco acima para comecar."
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Items}" Margin="6" Padding="0,4">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    CornerRadius="8" Padding="14,11" Margin="6,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Titulo -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}" />

                                    <!-- Botoes -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <Button Content="Reproduzir" Style="{StaticResource SmallButton}"
                                                Command="{Binding PlayCommand}" Margin="0,0,6,0"
                                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Abrir pasta" Style="{StaticResource SmallButton}"
                                                Command="{Binding OpenFolderCommand}" Margin="0,0,6,0"
                                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Cancelar" Style="{StaticResource SmallButton}"
                                                Command="{Binding CancelCommand}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- Barra de progresso -->
                                    <ProgressBar Grid.Row="1" Grid.Column="0"
                                                 Margin="0,9,0,0"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Maximum="100"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                    <!-- Status -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding DetailText, Converter={StaticResource EmptyToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Rodape -->
        <TextBlock Grid.Row="4" Text="{Binding ActivityText}"
                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Margin="2,12,0,0" />
    </Grid>
</Window>